[Unit]
Description=Hosted Hyperliquid MCP
After=network-online.target
Wants=network-online.target

[Service]
User=tendle-gateway
Group=tendle-gateway
WorkingDirectory=/opt/hosted-hyperliquid-mcp
Environment=PYTHONPATH=/opt/hosted-hyperliquid-mcp/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MCP_PUBLIC_URL=https://tendle.ai
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8080
Environment=HYPERLIQUID_TESTNET=false
ExecStart=/opt/hosted-hyperliquid-mcp/.venv/bin/python -m hosted_hyperliquid.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
LimitCORE=0
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
